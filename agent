#!/bin/bash
set -euo pipefail

TAO_REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ -z "${TAO_DEVENV:-}" ] && command -v devenv >/dev/null 2>&1; then
  exec devenv shell -- "$TAO_REPO_ROOT/agent" "$@"
fi

if ! command -v just >/dev/null 2>&1; then
  echo "just not found. Install devenv, run 'direnv allow', or enter 'devenv shell'." >&2
  exit 127
fi

case "${1:-help}" in
  help|setup|fmt|fix|prep-commit|test|lint|check|gen|build|clean|expo-runtime|compiler|headless-test-runtime|ide-extension|shared|cli|tao|git|git-create-branch|project-review)
    exec just --justfile agent.Justfile "$@"
    ;;
  *)
    exec just --justfile agent.Justfile _run-command "$@"
    ;;
esac
