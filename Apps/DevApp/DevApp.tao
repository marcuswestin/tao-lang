use Text, Number, Button, Box, Row, Col from @tao/ui

app TaoStudio {
   ui RootView
}

state GlobalCount = 100

ui RootView {
   render Col {
      Text "DEV APP"
      Number GlobalCount
      Button "Click me", StartDebugger { }
      Box {
         Text "Hello"
      }
   }

   // @Header Row {
   //     Text "Hello"
   //     Text "World"
   // }

   // @Body Row {
   //     Text "Hello"
   //     Text "World"
   // }
   // @Footer Row {
   //     Text "Hello"
   //     Text "World"
   // }
}

action StartDebugger {
   set GlobalCount += 1
   set GlobalCount += 1
}
