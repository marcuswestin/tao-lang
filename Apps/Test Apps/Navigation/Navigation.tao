app NavigationApp {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen HomeTabs

      screen Detail DetailScreen {
         title "Detail"
         path "/detail/:ItemId"
         param ItemId text
      }
   }
}

navigator HomeTabs {
   tabs {
      tab Home

      tab Search SearchView {
         title "Search"
         icon system search
      }
   }
}

ui Home {
   render Text "Navigation home"
}

ui SearchView {
   render Text "Search tab"
}

ui DetailScreen ItemId text {
   render Text ItemId
}

ui Text Value text {
   render inject ```ts
      const text = _ViewProps.Value.evaluate()
      return TR.Views.Text({ children: [text.jsValue] })
   ```
}
