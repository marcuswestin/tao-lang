use Text, Number, Row, Button, Col from @tao/ui

app ArithmeticOperatorsApp {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen RootView
   }
}

state GlobalCount = 0

alias Name = "Ro"

ui RootView {
   state LocalCount = 100
   alias Greeting = "Hello"
   alias DoubleGlobal = GlobalCount * 2
   render Col {
      Row {
         Text Greeting
         Text Name
      }
      Row {
         alias DoubleLocal = LocalCount * 2
         Button "Increment", action {
            set GlobalCount = GlobalCount + 1
            set LocalCount = LocalCount * 10
         }
         Text "GlobalCount: "
         Number GlobalCount
         Text "DoubleGlobal: "
         Number DoubleGlobal
         Text "LocalCount: "
         Number LocalCount
         Text "DoubleLocal: "
         Number DoubleLocal
      }
   }
}
