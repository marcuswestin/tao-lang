use Text, Number, Button, Row, Col from @tao/ui

app HandlersStateAndActionsApp {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen RootView
   }
}

state GlobalCount = 300

ui RootView {
   state Count1 = 100
   render Col {
      Number GlobalCount
      Row {
         state Count2 = 200
         Button "${ Count1 }", IncrementAction { }
         Button "${ Count2 }", IncrementAction2 { }
         action IncrementAction2 {
            set GlobalCount += 1
            set Count2 += 1
         }
      }
   }
   action IncrementAction {
      set GlobalCount += 1
      set Count1 += 1
   }
}
