app StdLibTextRenderApp {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen RootView
   }
}

use Button, Col, MultiLineText, Number, Row, Stack, Text, TextLabel, WrappingRow from @tao/ui

ui RootView {
   render Col [gap 8, pad 12] {
      Row [gap 8] {
         Text "Hello from std lib"
         Number 42
      }
      Stack [gap 4] {
         TextLabel "STD-LIB-LABEL"
         MultiLineText "This text variant is allowed to wrap naturally."
      }
      WrappingRow [gap 4] {
         Text "Chip one"
         Text "Chip two"
         Button "Tap", action { }
      }
   }
}
