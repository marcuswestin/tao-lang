use Text, Button, Col from @tao/ui

app TaoStudio {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen RootView
   }
}

state GlobalCount = 100

ui RootView {
   render Col {
      Text "Hello World"
      CountView { }
      Text "Global Count: " { }
      Button "${ GlobalCount }", GlobalIncrementAction { }
   }
}

ui CountView {
   state LocalCount = 200
   action LocalIncrementAction {
      set LocalCount += 1
      set GlobalCount += 1
   }
   state SubCount = 300
   action SubIncrementAction {
      set SubCount += 1
      set LocalCount += 1
      set GlobalCount += 1
   }
   ui SubCountView {
      render Col {
         Text "Sub Count 1:" { }
         Button "${ SubCount }", SubIncrementAction { }
      }
   }
   render Col {
      Text "Local Count:" { }
      Button "${ LocalCount }", LocalIncrementAction { }
      SubCountView { }
   }
}

action GlobalIncrementAction {
   set GlobalCount += 1
}
