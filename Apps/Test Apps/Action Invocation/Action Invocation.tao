use Number, Col, Button from @tao/ui

app ActionInvocationApp {
   navigation MainNavigation
}

navigator MainNavigation {
   stack {
      screen RootView
   }
}

state Counter = 100

alias ButtonTitle = "Up by 3"

type Title is text

ui FancyButton Title, Action action {
   render Button Title, Action
}

ui Root {
   render FancyButton Title "test", action { }
}

ui RootView {
   render Col {
      Number Counter
      Button ButtonTitle, UpBy3
      Button "Down by 1", DownBy1
      Button "Up by 3", UpBy3 { }
      Button "Down by 2", DownBy2
   }
   action UpBy3 {
      do BumpAction 3
   }
   action DownBy1 {
      do BumpAction -1
   }
   alias TwoDown = -2
   action DownBy2 {
      do BumpAction TwoDown
   }
   action BumpAction Step number {
      set Counter += Step
   }
}
