use Button, Col, Row, Text from @tao/ui

data MeetupData {
   type Status is text
   People Person {
      Name text,
      Email text optional unique,
      Events [Event],
      Rsvps [Rsvp],
   }
   Events Event {
      Title text,
      Host Person,
      Ordering number indexed,
      Rsvps [Rsvp],
   }
   Rsvps Rsvp {
      Event,
      Person,
      Status default "going",
   }
}

query MeetupData get first Person as CurrentUser

state EventCount = 0

action CreateEvent {
   set EventCount += 1
   create MeetupData.Event {
      Title "New Event ${ EventCount }",
      Ordering EventCount,
      Host CurrentUser
   }
}

app DataSchemaApp {
   provider InstantDB {
      appId "9faf89c0-c15c-49b4-bf3f-3b5b2cd9a19f"
      // just dev overrides these with the local LAN IP
      adminToken "90200000-0000-4000-8000-000000000003"
      apiURI "http://localhost:9020"
      websocketURI "ws://localhost:9020/runtime/session"
   }
   ui RootView
}

ui RootView {
   query MeetupData for Events as MyEvents
   > order Ordering desc
   guard {
      Text "Loading..."
   }
   render Col {
      Button "Create Event ${ EventCount }", CreateEvent
      Text "Data Schema Test App"
      for Event in MyEvents {
         Text "${ Event.Title}"
      }
   }
}
