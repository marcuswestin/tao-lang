use Button, Col, Row, Text from @tao/ui

data MeetupData {
   type Status is text
   People Person {
      Name text,
      Email text optional unique,
      Events [Event],
      Rsvps [Rsvp],
   }
   Events Event {
      Title text,
      Host Person,
      Ordering number indexed,
      Rsvps [Rsvp],
   }
   Rsvps Rsvp {
      Event,
      Person,
      Status default "going",
   }
}

query MeetupData.Person as CurrentUser {
   Email = "host@example.test",
   Name,
}

state EventCount = 0

action CreateEvent {
   set EventCount += 1
   create MeetupData.Event {
      Title "New Event ${ EventCount }",
      Ordering EventCount,
      Host CurrentUser
   }
}

app DataSchemaApp {
   provider InstantDB {
      appId "9faf89c0-c15c-49b4-bf3f-3b5b2cd9a19f"
      // just dev overrides these with the local LAN IP
      adminToken "90200000-0000-4000-8000-000000000003"
      apiURI "http://localhost:9020"
      websocketURI "ws://localhost:9020/runtime/session"
   }
   ui RootView
}

ui RootView {
   query MeetupData.Events as MyEvents {
      Title,
      Ordering,
   }
   query MeetupData.Events as EventDefaults
   query MeetupData.People as PersonDefaults
   query MeetupData.Event as EventWithBareLinks {
      id = "example-event-id",
      Host,
      Rsvps,
   }
   query MeetupData.Events as EventsWithBareLinks {
      Host,
      Rsvps,
   }
   query MeetupData.Events as EventsWithSpecifiedLinks {
      Title,
      Ordering,
      Host {
         Name,
         Email,
      },
      Rsvps {
         Status,
         Person,
      },
   }
   guard {
      Text "Loading..."
   }
   render Col {
      Button "Create Event ${ EventCount }", CreateEvent
      Text "Data Schema Test App"
      for MyEvent in MyEvents {
         Text "${ MyEvent.Title }"
      }
      Text "All event defaults:"
      for DefaultEvent in EventDefaults {
         Text "${ DefaultEvent.Title }"
      }
      Text "All people defaults:"
      for Person in PersonDefaults {
         Text "${ Person.Name }"
      }
      Text "Bare-link feed:"
      for BareLinkEvent in EventsWithBareLinks {
         Text "Bare-link row"
      }
      Text "Specified-link feed:"
      for SpecifiedLinkEvent in EventsWithSpecifiedLinks {
         Text "${ SpecifiedLinkEvent.Title }"
      }
   }
}
