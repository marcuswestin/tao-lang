use Text, Button, Col from @tao/ui

/** Child view declared inside parent view block (same pattern as Studio test app). */

share ui NestedViewsDemo {
   render OuterCard { }
}

ui OuterCard {
   state OuterN = 0
   state InnerN = 0
   action InnerInc {
      set InnerN += 1
      set OuterN += 1
   }
   ui InnerCard {
      render Col {
         Text "Inner card"
         Button "Inner ${ InnerN } (also +outer)", InnerInc { }
      }
   }
   render Col {
      Text "Nested views"
      Button "Outer ${ OuterN }", OuterInc { }
      InnerCard { }
   }
   action OuterInc {
      set OuterN += 1
   }
}
