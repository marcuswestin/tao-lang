{
  // Use compiler typescript version, for langium generated code to typecheck properly
  "typescript.tsdk": "packages/compiler/node_modules/typescript/lib",
  // Build extension and restart host (requires extension ryuta46.multi-command).
  "tao.workspaceKeybinding.buildAndRestart": true, // Necessary for multiCommand.buildExtensionThenRestartHost
  "multiCommand.commands": [
    {
      "command": "multiCommand.buildExtensionThenRestartHost",
      "interval": 3000,
      "sequence": [
        "workbench.action.tasks.build",
        "workbench.action.restartExtensionHost"
      ]
    }
  ],
  "files.exclude": {
    ".devenv": true,
    ".direnv": true,
    "**/node_modules": true,
    "**/tsconfig.tsbuildinfo": true
  },
  "editor.defaultFormatter": "dprint.dprint",
  "dprint.path": ".devenv/profile/bin/dprint",
  // Code Formatting: Tao Lang's extension, for .tao files.
  "[tao]": {
    "editor.defaultFormatter": "tao.tao-ide-extension"
  },
  // Langium and App Lang configs
  "langium.config": "packages/parser/langium-config.json"
}
