{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-package-and-install-extension",
      "type": "shell",
      "command": "devenv shell -- just ide-extension build-package-and-install",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "zsh",
          "args": ["-c"]
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
