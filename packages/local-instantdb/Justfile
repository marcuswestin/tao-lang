set dotenv-load := true
set shell := ["bash", "-euo", "pipefail", "-c"]

compose := "docker compose --env-file .env -f docker-compose.yml"
instant_repo := "https://github.com/instantdb/instant.git"
instant_commit := "9988b736198c01f0636d2c94270917e4f4180f7b"

default:
  @just --list

bootstrap:
  mkdir -p vendor
  if [ ! -d vendor/instant/.git ]; then \
    git clone --depth 1 {{instant_repo}} vendor/instant; \
  fi
  if ! git -C vendor/instant cat-file -e {{instant_commit}}^{commit}; then \
    git -C vendor/instant fetch --depth 1 origin {{instant_commit}}; \
  fi
  git -C vendor/instant checkout {{instant_commit}}

image: bootstrap
  {{compose}} build instant

# `compose up -d` starts detached containers; stopping the terminal or `just dev` does not stop them.
# If /health already responds, skip image/build/wait/seed so rerunning `just dev` is fast.
up:
  #!/usr/bin/env bash
  set -euo pipefail
  url="http://127.0.0.1:${INSTANT_PORT:?}/health"
  if curl -fsS --connect-timeout 2 --max-time 6 --retry 2 --retry-delay 1 --retry-all-errors "$url" >/dev/null 2>&1; then
    echo "[local-instantdb] Already healthy at ${url}; skipping image/build/up/wait/seed."
    exit 0
  fi
  just image
  {{compose}} up -d
  just _wait-for-local-instantdb
  just _seed

_wait-for-local-instantdb:
  #!/usr/bin/env bash
  set -euo pipefail
  url="http://127.0.0.1:${INSTANT_PORT:?}/health"
  echo "Waiting for InstantDB on ${url}"
  attempt=0
  until curl -fsS --connect-timeout 1 --max-time 2 --retry 2 --retry-delay 2 --retry-all-errors "$url" >/dev/null 2>&1; do
    attempt=$((attempt + 1))
    if [ "$attempt" -gt 120 ]; then
      echo
      echo "Timed out waiting for InstantDB"
      {{compose}} ps || true
      {{compose}} logs --tail 120 instant || true
      exit 1
    fi
    printf '.'
    sleep 1
  done
  echo ' ready'

_seed:
  {{compose}} exec -T postgres psql \
    -U "$POSTGRES_USER" \
    -d "$POSTGRES_DB" \
    -v app_id="$APP_ID" \
    -v admin_token="$ADMIN_TOKEN" \
    -f /dev/stdin < scripts/seed-app.sql

status:
  {{compose}} ps

logs:
  {{compose}} logs -f instant

down:
  {{compose}} down

reset:
  {{compose}} down
  docker volume rm local-instantdb_local-instantdb-postgres || true

reset-caches:
  {{compose}} down -v

config HOST="localhost":
  @echo "appId=$APP_ID"
  @echo "apiURI=http://{{HOST}}:$INSTANT_PORT"
  @echo "websocketURI=ws://{{HOST}}:$INSTANT_PORT/runtime/session"
