import "../shared/just/all-imports.just"

release-prep: _deps prebuild test

prebuild:
    #!{{ ZSH_INIT }}
    export LANG="en_US.UTF-8"
    export LC_ALL="en_US.UTF-8"
    export LC_CTYPE="en_US.UTF-8"
    if [[ -d ios ]]; then echo "prebuild already done"; exit 0; fi
    just build install-ios-platform
    bunx expo prebuild

build: _deps
    just cli build-lib {{ justfile_directory() }}/../../.builds/expo-runtime/_gen-tao-lib

install-ios-platform:
    xcodebuild -downloadPlatform iOS

web: _deps
    open -a "Google Chrome"
    BROWSER="Google Chrome" bunx expo start --web

ios: _deps
    bunx expo start --ios

device DEVICE="": _deps install-ios-platform
    #!{{ ZSH_INIT }}
    export LANG="en_US.UTF-8"
    export LC_ALL="en_US.UTF-8"
    export LC_CTYPE="en_US.UTF-8"
    npx expo run:ios --device "{{ DEVICE }}"

# Print the dev-client URL for the launcher's `Enter URL manually` fallback.
device-url:
    #!{{ ZSH_INIT }}
    ip=$(bash "{{ justfile_directory() }}/../shared/scripts/lan-ipv4.sh")
    echo "exp+tao-expo-runtime://expo-development-client/?url=http%3A%2F%2F${ip}%3A{{ DEV_METRO_PORT }}"

android *ARGS: _deps
    bunx expo run:android {{ ARGS }}

android-start *ARGS: _deps
    bunx expo start --android {{ ARGS }}

clean:
    rm -rf .expo
    rm -f expo-env.d.ts
    find . -maxdepth 1 -name '.metro-health-check*' -delete

clean-full: clean
    rm -rf ./node_modules ./ios ./android
    rm -rf ~/.expo

JEST_ARGS := "--detectOpenHandles --watchman=false"
JEST_WATCH_ARGS := JEST_ARGS + " --watch --silent --reporter=dot"

[no-quiet]
test *FILTER: _deps build
    bunx jest {{ JEST_ARGS }} {{ _JEST_REPORTER }} -t {{ FILTER }}

watch *FILTER:
    bunx jest {{ JEST_WATCH_ARGS }} -t {{ FILTER }}

_deps: _bun_deps

lint:
    bunx eslint .
